{
  "name": "arnaud-belec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:palette": "node --test lib/palette/*.test.mjs",
    "test:admin": "tsx --test lib/admin/*.test.ts",
    "test:blog": "tsx --test lib/blog/*.test.ts",
    "test:cms": "NODE_ENV=test tsx --test lib/cms/*.test.ts",
    "test:cms:disabled": "node scripts/cms/verify-disabled-build.mjs",
    "test:media": "tsx --test lib/media/*.test.ts",
    "test:media:browser": "node scripts/cms/verify-video-recovery-browser.mjs",
    "test:site": "tsx --test lib/visual/*.test.ts lib/audio/*.test.ts lib/newsletter/*.test.ts components/garment-viewer/*.test.ts components/site/*.test.tsx",
    "cms": "payload",
    "cms:db": "tsx scripts/cms/local-database.ts",
    "cms:reset-journal": "tsx scripts/cms/reset-journal.ts",
    "originals:import": "tsx scripts/cms/import-original.ts",
    "test:storage": "tsx --test lib/photographs/*.test.mjs lib/photographs/*.test.ts",
    "photos:migrate-r2": "node scripts/migrate-photographs-to-r2.mjs",
    "photos:import": "node scripts/import-photographs.mjs",
    "photos:reanalyze": "node scripts/reanalyse-photographs.mjs",
    "storage:setup": "node scripts/setup-photograph-storage.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@next/env": "16.4.3",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@supabase/supabase-js": "2.112.4",
    "exif-reader": "2.0.3",
    "file-type": "21.3.4",
    "graphql": "16.14.2",
    "motion": "^13.4.1",
    "next": "16.4.3",
    "payload": "3.92.1",
    "pg": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-socket": "0.2.17",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

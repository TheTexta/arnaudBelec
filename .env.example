NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-host.example
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_ADMIN_USER_IDS=your-supabase-auth-user-uuid

# Native Payload is OFF until migrations/import/verification and cutover approval.
ARNAUD_CMS_ENABLED=false
# Server-only, site-scoped Postgres login, SAME database as arnaud_blog_*.
# Use a verified TLS endpoint reachable from the deployment. Never a public var.
ARNAUD_CMS_DATABASE_URL=
PAYLOAD_SECRET=
# One exact origin, no wildcard. Local example: http://localhost:3105
ARNAUD_CMS_ORIGIN=

# Leave Supabase uploads enabled until the R2 rollout gates are approved.
ARNAUD_UPLOAD_STORAGE=supabase
# Blog uploads are independent of the photo provider. Enable only after the blog
# migration, site-scoped R2 credential, staging CORS, and acceptance checks.
ARNAUD_BLOG_UPLOADS_ENABLED=false
# Server-only R2 credentials: Object Read & Write, scoped to exactly the two
# buckets arnaudbelec and arnaudbelec-staging. Never use NEXT_PUBLIC_ prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-host.example
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_ADMIN_USER_IDS=your-supabase-auth-user-uuid

# Native Payload is OFF until the native-journal migration and approved cutover.
ARNAUD_CMS_ENABLED=false
# Server-only, site-scoped Postgres login: arnaud_cms on existing Coolify Supabase.
# Use a verified TLS endpoint reachable from the deployment. Never a public var.
ARNAUD_CMS_DATABASE_URL=
PAYLOAD_SECRET=
# One exact origin, no wildcard. Local example: http://localhost:3105
ARNAUD_CMS_ORIGIN=

# Keep off until the separately approved additive site migration is applied.
ARNAUD_SITE_EXPANSION_ENABLED=false
# Newsletter is independently default-off; requires published Site settings too.
ARNAUD_NEWSLETTER_ENABLED=false
ARNAUD_NEWSLETTER_API_KEY=
ARNAUD_NEWSLETTER_FROM=
# Stable, server-only random secret, at least 32 characters. Never NEXT_PUBLIC_*.
ARNAUD_NEWSLETTER_TOKEN_SECRET=

# Leave Supabase uploads enabled until the R2 rollout gates are approved.
ARNAUD_UPLOAD_STORAGE=supabase
# Journal uploads use native Payload client uploads, independent of photographs.
# Enable only after native migration, scoped R2 credentials and exact-origin
# staging CORS permitting Content-Type / If-None-Match / Range are verified.
ARNAUD_BLOG_UPLOADS_ENABLED=false
# Server-only Arnaud R2 credentials. Native journal files stay in the private
# arnaudbelec-staging/journal-native namespace, including published originals.
# Preserve photography's existing bucket scope. Never use NEXT_PUBLIC_ prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
